# Copy to .env (never commit .env). All config comes from env vars.

# development | test | production
ENV=development
# Turns on the "View as" persona picker (no login in the MVP). Refused if ENV=production or unset.
DEMO_MODE=true

# Browser origins allowed to call the API (comma-separated; '*' is refused).
CORS_ORIGINS=http://localhost:5173

# IANA timezone of the practice; defines "today" for today's visits.
PRACTICE_TIMEZONE=America/New_York

# --- Database (dev-only credentials for the local Docker Postgres) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# If you change POSTGRES_PORT, change the port in both URLs below too.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test

# --- Frontend (Vite exposes only VITE_* to the browser; never put secrets here) ---
VITE_API_BASE_URL=/api/v1
