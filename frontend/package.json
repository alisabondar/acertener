{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "test": "vp test --passWithNoTests",
    "test:coverage": "vp test --coverage",
    "test:e2e": "playwright test",
    "check": "vp check && vp test --passWithNoTests",
    "api:types": "cd ../backend && uv run python -m scripts.export_openapi && cd ../frontend && bun run api:generate",
    "api:generate": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false && vp fmt src/api"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  }
}
